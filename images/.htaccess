# Uploaded avatars live under images/avatars/. Never execute anything here.
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
Options -Indexes -ExecCGI
